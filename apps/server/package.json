    "start:built": "node dist/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@monkstracker/core": "workspace:*",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
